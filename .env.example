# Server-side only. Never expose this value with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional for local development. Production values are in wrangler.jsonc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Cloudflare Access service token for the private LLM bridge.
# Keep both values server-side and never commit real values.
LLM_ACCESS_CLIENT_ID=
LLM_ACCESS_CLIENT_SECRET=
